# === 必填配置 ===
LLM_API_KEY=                   # API 密钥，如 sk-xxxx
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
LLM_MODEL=deepseek-chat

# === Compaction 上下文压缩（可选，有默认值） ===
# LLM_COMPACTION_THRESHOLD=30        # 消息数阈值，超过触发压缩（默认 30）
# LLM_COMPACTION_TOKEN_THRESHOLD=8000 # Token 数阈值（默认 8000，0=禁用）
# LLM_COMPACTION_KEEP_RECENT=20      # 压缩后保留最近消息数（默认 20）

# === Skill 选择模式（可选） ===
# LLM_SKILL_SELECTION_MODE=auto      # auto / manual / all（默认 auto）

# === MinerU 文档解析服务（可选） ===
# MINERU_API_BASE_URL=https://mineru.net/api/v1/agent

# === Tavily 网络搜索（可选，不配置则 web_search 自动回退 DuckDuckGo） ===
# TAVILY_API_KEY=tvly-dev-xxxx
